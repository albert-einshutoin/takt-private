#compdef takt

_takt() {
  local -a root_commands pt_commands common mutation
  local command='' root_command='' index pt_index=0 skip_value=0 root_skip_value=0 root_ambiguous=0 short_index=0 short_name=''
  root_commands=(release-info run watch add list resume clear eject reset prompt export-cc export-codex catalog workflow metrics purge repertoire)
  pt_commands=(export inspect diff apply update rollback list)
  common=(--cwd --json)
  mutation=(--dry-run --apply --expected-plan-id --force)
  for (( index = 2; index < CURRENT; index++ )); do
    if (( pt_index == 0 )); then
      if (( root_skip_value )); then root_skip_value=0; continue; fi
      case ${words[index]} in
        --issue|--pr|--workflow|--branch|--repo|--provider|--model|--task|--isolation|--cwd)
          root_skip_value=1; continue ;;
        --issue=*|--pr=*|--workflow=*|--branch=*|--repo=*|--provider=*|--model=*|--task=*|--isolation=*|--cwd=*)
          continue ;;
        --auto-pr|--draft|--pipeline|--copy-workspace|--skip-git|--quiet|--continue|--help|--version)
          continue ;;
        --auto-pr=*|--draft=*|--pipeline=*|--copy-workspace=*|--skip-git=*|--quiet=*|--continue=*|--help=*|--version=*)
          continue ;;
        --) continue ;;
        --*) root_ambiguous=1; continue ;;
        -*)
          for (( short_index = 2; short_index <= ${#words[index]}; short_index++ )); do
            short_name=${words[index][short_index]}
            case $short_name in
              q|c|h|V) ;;
              i|w|b|t)
                if (( short_index == ${#words[index]} )); then
                  root_skip_value=1
                fi
                break ;;
              *) root_ambiguous=1; break ;;
            esac
          done
          continue ;;
        project-template)
          if [[ -z $root_command ]] && (( ! root_ambiguous )); then
            root_command=project-template
            pt_index=$index
          fi
          continue ;;
        *)
          if [[ -z $root_command ]]; then root_command=${words[index]}; fi
          continue ;;
      esac
    fi
    if (( pt_index > 0 )); then
      if (( skip_value )); then skip_value=0; continue; fi
      if [[ ${words[index]} == --cwd ]]; then skip_value=1; continue; fi
      if [[ ${words[index]} != -* ]]; then command=${words[index]}; break; fi
    fi
  done
  if (( pt_index == 0 )); then
    if (( ! root_ambiguous )); then
      case $root_command in
        reset) _values 'reset command' config categories ;;
        workflow) _values 'workflow command' init doctor ;;
        metrics) _values 'metrics command' review ;;
        repertoire) _values 'repertoire command' add remove list ;;
        '') _describe 'command' root_commands; _values 'command' project-template ;;
      esac
    fi
    return
  fi
  if [[ -z $command ]]; then
    _describe 'project template command' pt_commands
    _values 'option' --cwd
    return
  fi
  case $command in
    inspect|diff) _values 'option' $common --current-takt-version ;;
    list) _values 'option' $common ;;
    export) _values 'option' $common $mutation --pack-version --min-takt-version --source-commit --approve-policy --approve-capability ;;
    apply|update) _values 'option' $common $mutation --current-takt-version ;;
    rollback) _values 'option' $common $mutation ;;
  esac
}

_takt "$@"
